  m_Script: {fileID: 11500000, guid: 7ca53cb3dd6414148a04acf99f66fa0f, type: 3}
  m_Name: DD_Candy_Case_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - characterImage: {fileID: 2358774442571399510, guid: 80e30c7be3b292b43b1541bb89c83465, type: 3}
    character_Name: Candy Oh
    dialogueText: 'Ooooooh! Heeeey! '
    isEnd: 0
  - characterImage: {fileID: 2358774442571399510, guid: 80e30c7be3b292b43b1541bb89c83465, type: 3}
    character_Name: Candy Oh
    dialogueText: I miss you!
    isEnd: 0
  - characterImage: {fileID: 2358774442571399510, guid: 80e30c7be3b292b43b1541bb89c83465, type: 3}
    character_Name: Candy Oh
    dialogueText: Where have you been?
    isEnd: 0
  - characterImage: {fileID: 2358774442571399510, guid: 80e30c7be3b292b43b1541bb89c83465, type: 3}
    character_Name: Candy Oh
    dialogueText: Dad disappeared? I'm sorry!
    isEnd: 0
  - characterImage: {fileID: 2358774442571399510, guid: 80e30c7be3b292b43b1541bb89c83465, type: 3}
    character_Name: Candy Oh
    dialogueText: So, to turn your misfortune into good fortune, since today is the
      4th...
    isEnd: 0
  - characterImage: {fileID: 2358774442571399510, guid: 80e30c7be3b292b43b1541bb89c83465, type: 3}
    character_Name: Candy Oh
    dialogueText: Make a keyring with number 4 as the Lucky Number!
    isEnd: 0
  - characterImage: {fileID: 2358774442571399510, guid: 80e30c7be3b292b43b1541bb89c83465, type: 3}
    character_Name: Candy Oh
    dialogueText: Why would I pay money to buy my own luck?
    isEnd: 0
  - characterImage: {fileID: 2358774442571399510, guid: 80e30c7be3b292b43b1541bb89c83465, type: 3}
    character_Name: Candy Oh
    dialogueText: But the keyring is so pretty!
    isEnd: 1
  dialogueBifurcations:
  - characterImage: {fileID: 2358774442571399510, guid: 80e30c7be3b292b43b1541bb89c83465, type: 3}
    bifuractionText: BB
  - characterImage: {fileID: 2358774442571399510, guid: 80e30c7be3b292b43b1541bb89c83465, type: 3}
    bifuractionText: G
  - characterImage: {fileID: 2358774442571399510, guid: 80e30c7be3b292b43b1541bb89c83465, type: 3}
