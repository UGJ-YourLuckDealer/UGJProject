MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ca53cb3dd6414148a04acf99f66fa0f, type: 3}
  m_Name: DD_Licorice_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    character_Name: Licorice
    dialogueText: Hi...
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    character_Name: Licorice
    dialogueText: Um, how are you? Everything okay at home?
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    character_Name: Licorice
    dialogueText: (Glances around)
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    character_Name: Licorice
    dialogueText: ...
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    character_Name: Licorice
    dialogueText: Do you... sell those things?
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    character_Name: Licorice
    dialogueText: I mean...
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    character_Name: Licorice
    dialogueText: ...
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    character_Name: Licorice
    dialogueText: If you make those, could you make me one that has something to
      do with the [color=orange]number four[/color]?
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    character_Name: Licorice
    dialogueText: "See, in yesterday\u2019s game, the cleanup hitter..."
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    character_Name: Licorice
    dialogueText: Never mind.
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    character_Name: Licorice
    dialogueText: Could you just... make me one, please?
    isEnd: 1
  dialogueBifurcations:
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    bifuractionText: Oh... yes! This is exactly what I had in mind. Thank you!
  - characterImage: {fileID: 21300000, guid: b35605d5b3593a94a97ff1548ac56224, type: 3}
    bifuractionText: Oh, this looks nice... Thank you.
  - characterImage: {fileID: 21300000, guid: 6eaae92465fadef4ba545caa824867bb, type: 3}
    bifuractionText: Um... I was hoping for something a little different...
  receiptData: {fileID: 11400000, guid: 3e3fb4acbb22c5549bf6a97ca63b79b0, type: 2}
