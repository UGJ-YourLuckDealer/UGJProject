--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ca53cb3dd6414148a04acf99f66fa0f, type: 3}
  m_Name: DD_Biskuit_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - characterImage: {fileID: 21300000, guid: 98d258dfb9f09394c8acdd83eb604b66, type: 3}
    character_Name: Biskuit
    dialogueText: (Gives you an icy look)
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: d3d77f0c7b0609047b4c7f3525622380, type: 3}
    character_Name: Biskuit
    dialogueText: (Sighs)
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: 98d258dfb9f09394c8acdd83eb604b66, type: 3}
    character_Name: Biskuit
    dialogueText: "I don\u2019t like your little illegal business..."
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: 98d258dfb9f09394c8acdd83eb604b66, type: 3}
    character_Name: Biskuit
    dialogueText: 'But my friend is obsessed with superstitions

      so here I
      am.'
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: 98d258dfb9f09394c8acdd83eb604b66, type: 3}
    character_Name: Biskuit
    dialogueText: Make my key charm that has something to do with the number 7
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: 98d258dfb9f09394c8acdd83eb604b66, type: 3}
    character_Name: Biskuit
    dialogueText: ...
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: 98d258dfb9f09394c8acdd83eb604b66, type: 3}
    character_Name: Biskuit
    dialogueText: ...?
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: 98d258dfb9f09394c8acdd83eb604b66, type: 3}
    character_Name: Biskuit
    dialogueText: Hurry up before someone sees us!
    isEnd: 1
  dialogueBifurcations:
  - characterImage: {fileID: 21300000, guid: 98d258dfb9f09394c8acdd83eb604b66, type: 3}
    bifuractionText: ...This is perfect. My friend will love it. Thanks.
  - characterImage: {fileID: 21300000, guid: 98d258dfb9f09394c8acdd83eb604b66, type: 3}
    bifuractionText: This should do. Thanks...
  - characterImage: {fileID: 21300000, guid: d3d77f0c7b0609047b4c7f3525622380, type: 3}
    bifuractionText: ...This is not what I asked for.
  receiptData: {fileID: 11400000, guid: 6180b6e41fbd3e749a033104b98231a2, type: 2}
