  m_Script: {fileID: 11500000, guid: 7ca53cb3dd6414148a04acf99f66fa0f, type: 3}
  m_Name: DD_Candy_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - characterImage: {fileID: 21300000, guid: fbb52a8ebe361f44988925f973692ae1, type: 3}
    character_Name: Candy
    dialogueText: Hey!
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: fbb52a8ebe361f44988925f973692ae1, type: 3}
    character_Name: Candy
    dialogueText: I heard you sell custom key charms!
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: fbb52a8ebe361f44988925f973692ae1, type: 3}
    character_Name: Candy
    dialogueText: "You know what day it is? It\u2019s the fourth! The FOURTH! "
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: b7ea062bf234a2f4092c02278dbf1efa, type: 3}
    character_Name: Candy
    dialogueText: "Where I\u2019m from, four sounds like the word for DEATH!"
    isEnd: 0
  - characterImage: {fileID: 21300000, guid: fbb52a8ebe361f44988925f973692ae1, type: 3}
    character_Name: Candy
    dialogueText: So. I need a charm to make four my LUCKY NUMBER!
    isEnd: 1
  dialogueBifurcations:
  - characterImage: {fileID: 21300000, guid: fbb52a8ebe361f44988925f973692ae1, type: 3}
    bifuractionText: YES! Four is officially my LUCKY NUMBER!
  - characterImage: {fileID: 21300000, guid: fbb52a8ebe361f44988925f973692ae1, type: 3}
    bifuractionText: Ooh, nice! Four is looking luckier already!
  - characterImage: {fileID: 21300000, guid: b7ea062bf234a2f4092c02278dbf1efa, type: 3}
    bifuractionText: Wait... Is that supposed to ward off DEATH?!
  receiptData: {fileID: 11400000, guid: 3e3fb4acbb22c5549bf6a97ca63b79b0, type: 2}
